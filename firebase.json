{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "database": "(default)",
    "location": "europe-west1"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "vitePOS",
        "supportEmail": "makuntimapeniel80@gmail.com"
      }
    }
  },
  "hosting": [
    {
      "site": "getvitepos",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/@(sw.js|workbox-*.js|index.html|manifest.webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "vitepos-rdc",
      "public": "site/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": true,
      "headers": [
        {
          "source": "/_astro/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/@(sw.js|index.html)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "vitepos-be79c",
      "public": "hosting-redirect",
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://getvitepos.web.app/:1",
          "type": 301
        }
      ]
    },
    {
      "site": "vitepos-app",
      "public": "hosting-redirect",
      "redirects": [
        {
          "regex": "^/(.*)$",
          "destination": "https://getvitepos.web.app/:1",
          "type": 301
        }
      ]
    }
  ]
}
