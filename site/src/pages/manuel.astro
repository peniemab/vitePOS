---
/**
 * Manuel de l'utilisateur façon journal : une de couverture, sommaire numéroté, un chapitre par moment
 * de la journée. Se lit sur le site et s'imprime en PDF A4 (styles @media print de manuel.css).
 */
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { chapters, edition } from "../data/manuel";
import { APP_URL } from "../data/content";
import "../styles/manuel.css";

const num = (i: number) => String(i + 1).padStart(2, "0");
---

<Base
  title="Le journal de votre boutique · Manuel vitePOS"
  description="Le manuel de vitePOS, pas à pas : créer sa boutique, préparer le stock, vendre en FC, $ ou €, fermer la journée et suivre ses chiffres, même sans réseau."
>
  <article class="mag">
    <!-- Une -->
    <header class="mag-cover">
      <div class="wrap mag-cover-grid">
        <div>
          <p class="mag-masthead">Le journal de votre boutique <span>· {edition}</span></p>
          <h1>vitePOS,<br /><em>mode d'emploi</em></h1>
          <p class="mag-cover-lead">
            Tout ce qu'il faut pour tenir la caisse, le stock et les comptes de votre boutique, du matin au soir, même quand le
            réseau coupe.
          </p>
          <ul class="mag-cover-teasers">
            <li><b>{num(4)}</b> Recevoir 3 paquets sans compter 72 bouteilles</li>
            <li><b>{num(6)}</b> Encaisser en FC, $ ou € en quelques secondes</li>
            <li><b>{num(9)}</b> Fermer la journée sans surprise</li>
          </ul>
          <a class="btn mag-noprint" href="/manuel-vitepos.pdf" download>Télécharger le PDF</a>
        </div>
        <div class="mag-cover-shot">
          <Shot name="tel-caisse" device="tel" alt="La caisse de vitePOS" eager />
        </div>
      </div>
    </header>

    <!-- Sommaire -->
    <nav class="mag-toc wrap" aria-label="Sommaire">
      <h2>Au sommaire</h2>
      <ol>
        {
          chapters.map((c, i) => (
            <li>
              <a href={`#${c.id}`}>
                <span class="mag-toc-num">{num(i)}</span>
                <span>
                  <small>{c.kicker}</small>
                  {c.title}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- Chapitres -->
    {
      chapters.map((c, i) => (
        <section id={c.id} class:list={["mag-chapter", { "mag-alt": i % 2 === 1 }]}>
          <div class="wrap">
            <header class="mag-head">
              <span class="mag-num" aria-hidden="true">
                {num(i)}
              </span>
              <div>
                <p class="mag-kicker">{c.kicker}</p>
                <h2>{c.title}</h2>
              </div>
            </header>
            <p class="mag-lead">{c.lead}</p>

            <div class:list={["mag-body", { "mag-noshot": !c.shot }]}>
              <div>
                <ol class="mag-steps">
                  {c.steps.map((s) => (
                    <li set:html={s} />
                  ))}
                </ol>

                {c.table && (
                  <div class="mag-table">
                    <table>
                      <thead>
                        <tr>
                          {c.table[0].map((h) => (
                            <th>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {c.table.slice(1).map((row) => (
                          <tr>
                            {row.map((cell, j) => (j === 0 ? <th>{cell}</th> : <td class:list={{ no: cell === "Non" }}>{cell}</td>))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                {c.figure && (
                  <p class="mag-figure">
                    <b>{c.figure.value}</b>
                    {c.figure.text}
                  </p>
                )}
                {c.tip && (
                  <aside class="mag-box mag-tip">
                    <b>Astuce · {c.tip.title}</b>
                    <p>{c.tip.text}</p>
                  </aside>
                )}
                {c.warn && (
                  <aside class="mag-box mag-warn">
                    <b>Attention · {c.warn.title}</b>
                    <p>{c.warn.text}</p>
                  </aside>
                )}
              </div>

              {c.shot && (
                <figure class="mag-shot">
                  <Shot name={c.shot.name} device="tel" alt={c.shot.alt} />
                  <figcaption>{c.shot.caption}</figcaption>
                </figure>
              )}
            </div>
          </div>
        </section>
      ))
    }

    <!-- Dernière page -->
    <footer class="mag-back">
      <div class="wrap">
        <p class="mag-masthead">Fin du numéro</p>
        <h2>À vous de vendre.</h2>
        <p>
          Ouvrez <b>{APP_URL.replace("https://", "")}</b> sur votre téléphone. Une question ? Montrez cette page à votre
          vendeur : tout y est, pas à pas.
        </p>
        <a class="btn btn-light mag-noprint" href={APP_URL}>Ouvrir vitePOS</a>
      </div>
    </footer>
  </article>
</Base>
