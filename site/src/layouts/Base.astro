---
/** Squelette commun à toutes les pages : en-tête HTML, langue, métadonnées de partage, polices, styles. */
import "../styles/global.css";
import "../styles/devices.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { floaterArt } from "../data/floaters";
import { dicts, otherLang, route, type Lang, type PageKey } from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Page courante : sert au bouton FR / EN et aux liens vers l'autre langue. */
  page: PageKey;
}
const { title, description, lang, page } = Astro.props;
const t = dicts[lang];
const abs = (p: string) => new URL(p, Astro.site).href;

/**
 * Objets qui flottent sur toute la largeur du fond, derrière le contenu : répartis en colonnes régulières,
 * espacés dans le temps (délais négatifs) pour un flux continu, sans grand vide. Valeurs « au hasard » mais fixes.
 */
const COUNT = 18;
const DURATION = 30;
const floaters = Array.from({ length: COUNT }, (_, i) => {
  const art = floaterArt[(i * 7) % floaterArt.length];
  const r = (n: number) => ((Math.sin((i + 1) * 12.9898 + n * 78.233) * 43758.5453) % 1 + 1) % 1;
  const far = i % 3 === 1; // un objet sur trois plus loin : plus petit, plus pâle, légèrement flou
  return {
    svg: art.svg,
    style: [
      `left: ${(((i + 0.2 + r(1) * 0.6) / COUNT) * 100).toFixed(1)}%`,
      `--w: ${Math.round(art.w * (far ? 0.7 : 0.9 + r(2) * 0.3))}px`,
      `--dx: ${Math.round((r(3) - 0.5) * 60)}px`,
      `--r0: ${Math.round((r(4) - 0.5) * 40)}deg`,
      `--r1: ${Math.round((r(5) - 0.5) * 60)}deg`,
      `--o: ${far ? 0.28 : 0.55}`,
      `--blur: ${far ? 1.5 : 0}px`,
      `animation-duration: ${Math.round(DURATION * (0.8 + r(6) * 0.4))}s`,
      // Délais en quinconce (i × 7 modulo COUNT) : deux voisins ne montent jamais ensemble.
      `animation-delay: ${(-(((i * 7) % COUNT) * DURATION) / COUNT).toFixed(1)}s`,
    ].join("; "),
  };
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a2b4c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={abs(Astro.url.pathname)} />
    <link rel="alternate" hreflang={lang} href={abs(route(lang, page))} />
    <link rel="alternate" hreflang={otherLang(lang)} href={abs(route(otherLang(lang), page))} />
    <link rel="alternate" hreflang="x-default" href={abs(route("fr", page))} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={t.locale} />
    <link rel="preload" href="/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- Fond animé de tout le site : halos bleu et rouge, fines lignes à l'angle du trait du logo, réseau de boutiques connectées et objets du commerce qui flottent. -->
    <div class="page-bg" aria-hidden="true">
      <span class="glow glow-1"></span>
      <span class="glow glow-2"></span>
      <span class="glow glow-3"></span>
      <span class="slashes"></span>
      <canvas class="network"></canvas>
      <div class="floaters">
        {floaters.map((it) => <span class="floater" style={it.style} set:html={it.svg} />)}
      </div>
    </div>
    <Header lang={lang} page={page} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Réseau de boutiques connectées : des points qui dérivent derrière le contenu et se relient quand ils sont proches.
      const canvas = document.querySelector<HTMLCanvasElement>(".network");
      const ctx = canvas?.getContext("2d");
      if (canvas && ctx) {
        let w = 0;
        let h = 0;
        let points: { x: number; y: number; vx: number; vy: number; red: boolean }[] = [];
        let mouse: { x: number; y: number } | null = null;
        const LINK = 140;
        const resize = () => {
          const dpr = Math.min(1.5, window.devicePixelRatio || 1);
          w = window.innerWidth;
          h = window.innerHeight;
          canvas.width = w * dpr;
          canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // Moins de points sur les petits écrans : plus léger pour les téléphones.
          const n = Math.round(Math.min(60, Math.max(18, (w * h) / 22000)));
          points = Array.from({ length: n }, (_, i) => ({
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.3,
            red: i % 8 === 0,
          }));
        };
        let running = true;
        const frame = () => {
          if (!running) return;
          ctx.clearRect(0, 0, w, h);
          for (const p of points) {
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0 || p.x > w) p.vx *= -1;
            if (p.y < 0 || p.y > h) p.vy *= -1;
          }
          ctx.lineWidth = 1;
          for (let i = 0; i < points.length; i++) {
            const a = points[i];
            for (let j = i + 1; j < points.length; j++) {
              const b = points[j];
              const d = Math.hypot(a.x - b.x, a.y - b.y);
              if (d < LINK) {
                ctx.strokeStyle = `rgba(130, 165, 230, ${(1 - d / LINK) * 0.22})`;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
              }
            }
            if (mouse) {
              const d = Math.hypot(a.x - mouse.x, a.y - mouse.y);
              if (d < 180) {
                ctx.strokeStyle = `rgba(255, 90, 95, ${(1 - d / 180) * 0.4})`;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(mouse.x, mouse.y);
                ctx.stroke();
              }
            }
          }
          for (const p of points) {
            ctx.fillStyle = p.red ? "rgba(255, 77, 82, 0.75)" : "rgba(200, 215, 245, 0.45)";
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.red ? 2.6 : 1.6, 0, Math.PI * 2);
            ctx.fill();
          }
          requestAnimationFrame(frame);
        };
        resize();
        window.addEventListener("resize", resize);
        window.addEventListener("pointermove", (e) => (mouse = e.pointerType === "mouse" ? { x: e.clientX, y: e.clientY } : null), { passive: true });
        // Onglet caché : on arrête de dessiner (batterie des téléphones).
        document.addEventListener("visibilitychange", () => {
          running = !document.hidden;
          if (running) requestAnimationFrame(frame);
        });
        requestAnimationFrame(frame);
      }
    </script>
  </body>
</html>
