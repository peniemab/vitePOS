---
/** Page d'accueil du site, dans la langue demandée (pages/index.astro en français, pages/en/index.astro en anglais). */
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import Photo from "../components/Photo.astro";
import ComicPanel from "../components/ComicPanel.astro";
import { APP_URL, SIGNUP_URL } from "../data/content";
import { alertIcon, deviceIcons, icons, moreIcons, navIcons } from "../data/icons";
import { dicts, PDF, route, type Lang } from "../i18n";
import "../styles/home.css";
import { existsSync } from "node:fs";
import { join } from "node:path";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const h = t.home;
const ids = h.ids;

/** Photo et capture de chaque diapositive, dans l'ordre de `h.slides`. */
const slideMedia = [
  { photo: "supermarche", shot: "tel-caisse", alt: h.altCaisse },
  { photo: "pharmacie-comptoir", shot: "tel-stock", alt: h.shots.telStock.alt },
  { photo: "telephonie", shot: "tel-ticket", alt: h.shots.telTicket.alt },
  { photo: "quincaillerie", shot: "tel-stock", alt: h.shots.telStock.alt },
  { photo: "boutique", shot: "tel-accueil", alt: h.altHome },
];
/** Capture de chaque onglet de la galerie, dans l'ordre de `h.gallery.tabs`. */
const galleryShots = [
  { name: "tel-accueil", device: "tel" },
  { name: "tablette-caisse", device: "tablette" },
  { name: "ordi-stock", device: "ordi" },
  { name: "ordi-ventes", device: "ordi" },
  { name: "ordi-journee", device: "ordi" },
  { name: "tel-ticket", device: "tel" },
] as const;
const receiptIcons = [moreIcons.store, moreIcons.mapPin, moreIcons.qr, moreIcons.barcode];
/** Le bloc « Une semaine plus tard » n'apparaît qu'une fois son dessin ajouté (public/bd/bd-8.webp). */
const resultReady = existsSync(join(process.cwd(), "public", "bd", `bd-${h.comic.result.art}.webp`));
const strengthIcons = [moreIcons.cash, moreIcons.wifiOff, moreIcons.users];
/** Icône de chaque secteur de l'accroche, dans l'ordre de `h.slides`. */
const sectorIcons = [moreIcons.store, alertIcon, moreIcons.deviceMobile, icons.package, icons.chartBar];
/** Icône de chaque question, dans l'ordre de `t.faqs` : prix, matériel, hors ligne, installation, devises, sécurité. */
const faqIcons = [navIcons.tag, moreIcons.deviceMobile, moreIcons.wifiOff, navIcons.download, moreIcons.cash, moreIcons.shieldCheck];

/** Une notification « Vente · 2 sacs de ciment · 40 $ » : l'action, puis le chiffre (dernier morceau) mis en avant. */
function toToast(text: string) {
  const parts = text.split(" · ");
  const value = parts.length > 1 ? parts.pop()! : "";
  const label = parts.join(" · ");
  const kind = /^(Alerte|Alert)/.test(label)
    ? "alert"
    : /^(IMEI|Trouvé|Found|Ticket|Receipt|Client|Customer)/.test(label)
      ? "scan"
      : /^(Stock|Réception|Delivery|Inventaire|Stocktake|Clôture|Closing|Caisse ouverte|Till opened)/.test(label)
        ? "stock"
        : "sale";
  const icon = { alert: alertIcon, scan: moreIcons.barcode, stock: icons.package, sale: moreIcons.cash }[kind];
  return { label, value, kind, icon };
}
---

<Base title={h.title} description={h.description} lang={lang} page="home">
  <!-- Accroche : le titre reste fixe ; la photo, le téléphone et la ligne du secteur changent (une diapositive par type de commerce). -->
  <section class="hero" aria-roledescription="carousel" aria-label={h.carousel.label} data-carousel>
    <div class="hero-bgs" aria-hidden="true">
      {
        slideMedia.map((m, i) => (
          <div class:list={["hero-bg", { "is-active": i === 0 }]} data-bg>
            <Photo name={m.photo} alt="" class="slide-bg" eager={i === 0} sizes="100vw" />
          </div>
        ))
      }
    </div>
    <div class="wrap hero-inner">
      <div class="hero-text">
        <p class="hero-kicker"><span class="live-dot"></span>{h.kicker}</p>
        <h1 class="slide-title">
          <span>{h.h1[0]}</span> <span>{h.h1[1]}</span> <span class="accent">{h.h1[2]}</span>
        </h1>
        <p class="lead">{h.lead}</p>
        <div class="sector">
          {
            h.slides.map((s, i) => (
              <div class:list={["sector-item", { "is-active": i === 0 }]} aria-hidden={i === 0 ? undefined : "true"} data-sector>
                <span class="sector-icon" set:html={sectorIcons[i]} />
                <div>
                  <b>{s.tag}</b>
                  <span>{s.line}</span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="cta-row">
          <a class="btn btn-lg" href={SIGNUP_URL} aria-label={h.ctaStart}>
            <span class="cta-long">{h.ctaStart}</span><span class="cta-short">{h.ctaStartShort}</span>
            <span class="btn-icon" set:html={moreIcons.arrowRight} />
          </a>
          <a class="btn btn-lg btn-light" href={`#${ids.gallery}`}>
            <span class="btn-icon" set:html={moreIcons.deviceMobile} />
            {h.ctaSee}
          </a>
        </div>
        <ul class="ticks">
          {
            h.ticks.map((tick) => (
              <li>
                <span set:html={moreIcons.check} />
                {tick}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="slides">
        {
          h.slides.map((s, i) => {
            const m = slideMedia[i];
            return (
              <div
                class:list={["slide", { "is-active": i === 0 }]}
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} / ${h.slides.length} : ${s.tag}`}
                aria-hidden={i === 0 ? undefined : "true"}
                data-slide
              >
                <div class="slide-device">
                  <Shot name={m.shot} device="tel" alt={m.alt} eager={i === 0} />
                  {/* Notifications de ventes, propres au secteur : le script les fait apparaître une à une. */}
                  <div class="toasts" aria-hidden="true" data-toasts>
                    {s.pops.map(toToast).map((n) => (
                      <div class={`toast toast-${n.kind}`}>
                        <span class="toast-icon" set:html={n.icon} />
                        <div class="toast-body">
                          <span class="toast-head">
                            <img src="/logo.svg" alt="" width="12" height="13" />
                            vitePOS<span class="toast-time">{h.carousel.now}</span>
                          </span>
                          <span class="toast-label">{n.label}</span>
                          {n.value && <b class="toast-value">{n.value}</b>}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- Animation de fond tirée du logo : le grand « V » en filigrane, son point rouge qui bat à chaque vente,
         et son trait rouge qui traverse l'image à chaque changement de diapositive. -->
    <div class="hero-fx" aria-hidden="true">
      <svg class="mark" viewBox="-140 -140 280 305">
        <path class="mark-v" d="M-130,-105 L-60,-105 L-20,60 L50,-105 L125,-105 L10,125 C-2,145 -18,155 -35,155 C-52,155 -68,145 -80,125 Z" />
        <polygon class="mark-slash" points="-15,-30 40,-130 95,-130 15,20" />
        <circle class="mark-dot" cx="85" cy="-70" r="14" />
      </svg>
      <div class="sweep"></div>
    </div>

    <!-- Une seule ligne fixe sur toute la largeur du bas : seul le point rouge du logo avance dessus,
         d'une diapositive à l'autre. Elle est découpée en zones cliquables invisibles, une par diapositive. -->
    <div class="progress" data-controls hidden>
      <div class="progress-line"></div>
      <span class="progress-head" data-head></span>
      <div class="progress-hit">
        {
          h.slides.map((s, i) => (
            <button type="button" class="seg" aria-label={`${h.carousel.goTo} ${i + 1} : ${s.tag}`} aria-current={i === 0 ? "true" : undefined} data-dot={i} />
          ))
        }
      </div>
    </div>

    <div class="wrap hero-controls" data-controls hidden>
      <div class="sector-tabs">
        {
          h.slides.map((s, i) => (
            <button type="button" class="sector-tab" aria-label={`${h.carousel.goTo} ${i + 1} : ${s.tag}`} aria-current={i === 0 ? "true" : undefined} data-dot={i}>
              {s.short}
            </button>
          ))
        }
      </div>
      <a class="hero-pdf" href={PDF[lang].brochure} download>
        <span set:html={navIcons.download} />
        {h.brochureLink}
      </a>
      <div class="arrows">
        <button type="button" class="round" aria-label={h.carousel.pause} data-toggle data-label-pause={h.carousel.pause} data-label-play={h.carousel.play}>
          <span class="i-pause" set:html={moreIcons.pause} /><span class="i-play" set:html={moreIcons.play} />
        </button>
        <button type="button" class="round" aria-label={h.carousel.prev} data-prev set:html={moreIcons.chevronLeft} />
        <button type="button" class="round" aria-label={h.carousel.next} data-next set:html={moreIcons.chevronRight} />
      </div>
    </div>
  </section>

  <!-- Points forts, posés à cheval sur le bas de l'accroche -->
  <section class="wrap strengths" aria-label={h.eyebrow}>
    {
      t.strengths.map((s, i) => (
        <div class="strength">
          <span class="strength-icon" set:html={strengthIcons[i]} />
          <div>
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Bande de ventes qui défile, comme le rouleau d'une caisse -->
  <div class="tape" aria-hidden="true">
    <div class="tape-track">
      {[0, 1].map(() => h.tape.map((item) => <span class="tape-item">{item}</span>))}
    </div>
  </div>

  <!-- Pourquoi : la BD de Maman Ngalula. Chaque ligne montre le problème à gauche et sa solution à droite. -->
  <section class="section why" id="pourquoi" data-comic>
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.whyEyebrow}</p>
        <h2>{h.whyTitle}</h2>
        <p class="section-lead">{h.comic.lead}</p>
      </header>
      <!-- Le déclic d'abord : Patrick invite sa tante à essayer vitePOS, à côté du bouton. Les lignes en dessous le prouvent. -->
      <div class="comic-spark">
        <ComicPanel
          art={h.comic.spark.art}
          caption=""
          bubbles={h.comic.spark.bubbles}
          kind="spark"
          label={h.comic.spark.caption}
          placeholder={h.comic.placeholder}
        />
        <div class="comic-spark-text">
          <p>{h.comic.end}</p>
          <a class="btn btn-lg" href={SIGNUP_URL}>{h.ctaStart} <span class="btn-icon" set:html={moreIcons.arrowRight} /></a>
        </div>
      </div>
      <!-- Juste après : Grâce et sa patronne, satisfaites, une semaine plus tard (affiché seulement quand le dessin existe). -->
      {resultReady && (
      <div class="comic-result">
        <div class="comic-result-text">
          <h3>{h.comic.result.title}</h3>
          <p>{h.comic.result.text}</p>
        </div>
        <ComicPanel
          art={h.comic.result.art}
          caption=""
          bubbles={h.comic.result.bubbles}
          kind="solution"
          label={h.comic.columns.after}
          placeholder={h.comic.placeholder}
        />
      </div>
      )}
      <div class="comic-cols" aria-hidden="true">
        <span class="col-before">{h.comic.columns.before}</span>
        <span class="col-after">{h.comic.columns.after}</span>
      </div>
      <ol class="comic">
        {
          h.comic.rows.map((row, i) => (
            <li class="comic-row" style={`--i: ${i}`}>
              <h3 class="row-topic">{row.topic}</h3>
              <ComicPanel {...row.problem} kind="problem" label={h.comic.columns.before} placeholder={h.comic.placeholder} />
              <span class="row-arrow" aria-hidden="true" set:html={moreIcons.arrowRight} />
              <ComicPanel {...row.solution} kind="solution" label={h.comic.columns.after} placeholder={h.comic.placeholder} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fonctions -->
  <section id={ids.features} class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.featuresEyebrow}</p>
        <h2>{h.featuresTitle}</h2>
        <p class="section-lead">{h.featuresLead}</p>
      </header>
      <div class="cards">
        {
          t.features.map((f) => (
            <article class="card">
              <div class="icon" set:html={icons[f.icon]} />
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Aperçu : de vraies captures, un onglet par écran (onglets en CSS seul, sans JavaScript). -->
  <section class="section gallery" id={ids.gallery}>
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.gallery.eyebrow}</p>
        <h2>{h.gallery.title}</h2>
        <p class="section-lead">{h.gallery.lead}</p>
      </header>
      <div class="gallery-box">
        {h.gallery.tabs.map((_, i) => <input type="radio" name="gallery" id={`g-${i}`} class="gallery-radio" checked={i === 0} />)}
        <div class="gallery-bar">
          {h.gallery.tabs.map((tab, i) => <label for={`g-${i}`}>{tab.label}</label>)}
        </div>
        <div class="gallery-panels">
          {
            h.gallery.tabs.map((tab, i) => (
              <figure class={`gallery-panel gp-${i} gp-${galleryShots[i].device}`}>
                <div class="gallery-shot">
                  <Shot name={galleryShots[i].name} device={galleryShots[i].device} alt={tab.alt} />
                </div>
                <figcaption>
                  <b>{tab.label}</b>
                  <span>{tab.text}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Ticket de caisse personnalisé -->
  <section class="section receipt-feature">
    <div class="wrap receipt-split">
      <div>
        <p class="kicker">{h.receipt.eyebrow}</p>
        <h2>{h.receipt.title}</h2>
        <p class="section-lead">{h.receipt.lead}</p>
        <ul class="receipt-points">
          {
            h.receipt.points.map((pt, i) => (
              <li>
                <span class="receipt-point-icon" set:html={receiptIcons[i]} />
                <div>
                  <b>{pt.title}</b>
                  <span>{pt.text}</span>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="receipt-printers"><span set:html={moreIcons.printer} />{h.receipt.printers}</p>
      </div>
      <div class="receipt-paper">
        <img src="/captures/ticket-exemple.webp" alt={h.receipt.alt} width="384" height="1648" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- Appareils : une seule scène animée. Une vente faite sur la tablette part vers l'ordinateur et le téléphone. -->
  <section id={ids.devices} class="section devices">
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.devicesEyebrow}</p>
        <h2>{h.devicesTitle}</h2>
        <p class="section-lead">{h.devicesLead}</p>
      </header>

      <!-- Les appareils où l'on utilise vitePOS : c'est le cœur de la section. -->
      <ul class="device-cards">
        {
          h.deviceCards.map((d, i) => (
            <li>
              <span class="device-card-icon" set:html={[moreIcons.deviceMobile, deviceIcons.tablet, deviceIcons.laptop, moreIcons.printer][i]} />
              <b>{d.name}</b>
              <small>{d.systems}</small>
              <span>{d.text}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="sync-title">{h.syncTitle}</h3>
      <div class="sync-stage">
        <div class="sync-device sync-laptop">
          <Shot name="ordi-journee" device="ordi" alt={h.shots.ordiJournee.alt} />
          <span class="sync-toast sync-toast-laptop" aria-hidden="true"><span set:html={moreIcons.check} />{h.sync.laptopToast}</span>
        </div>
        <div class="sync-device sync-tablet">
          <Shot name="tablette-caisse" device="tablette" alt={h.shots.tabletteCaisse.alt} />
          <span class="sync-sale" aria-hidden="true"><small>{h.sync.sale}</small><b>{h.sync.amount}</b></span>
        </div>
        <div class="sync-device sync-phone">
          <Shot name="tel-accueil" device="tel" alt={h.shots.telAccueil.alt} />
          <span class="sync-toast sync-toast-phone" aria-hidden="true"><span set:html={moreIcons.check} />{h.sync.phoneToast}</span>
        </div>
        <!-- Liaisons entre les appareils : la vente voyage de la tablette vers l'ordinateur et le téléphone. -->
        <svg class="sync-links" viewBox="0 0 1600 1000" aria-hidden="true">
          <path id="link-laptop" d="M430 640 C 470 520, 560 470, 700 430" />
          <path id="link-phone" d="M620 870 C 900 960, 1150 930, 1330 800" />
          <circle r="9" class="sync-dot"><animateMotion dur="6s" repeatCount="indefinite" keyPoints="0;0;1;1" keyTimes="0;0.12;0.3;1" calcMode="linear"><mpath href="#link-laptop" /></animateMotion></circle>
          <circle r="9" class="sync-dot"><animateMotion dur="6s" repeatCount="indefinite" keyPoints="0;0;1;1" keyTimes="0;0.12;0.36;1" calcMode="linear"><mpath href="#link-phone" /></animateMotion></circle>
        </svg>
      </div>

      <div class="compat">
        <h3>{h.compatTitle}</h3>
        <ul class="compat-list">
          {h.compatHardware.map((x, i) => <li><span set:html={[moreIcons.barcode, moreIcons.printer, moreIcons.deviceMobile][i]} />{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Pour qui : la liste des secteurs et les villes -->
  <section id={ids.audiences} class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.audiencesEyebrow}</p>
        <h2>{h.audiencesTitle}</h2>
        <p class="section-lead">{h.audiencesLead}</p>
      </header>
      <div class="sectors">
        <p><b>{h.sectorsAll}</b></p>
        <ul>
          {t.sectors.map((s) => <li>{s}</li>)}
        </ul>
        <p class="cities"><span set:html={moreIcons.mapPin} />{t.cities}</p>
      </div>
      <!-- Bouton gardé de l'ancienne mosaïque. -->
      <div class="sectors-cta">
        <a class="btn btn-lg" href={SIGNUP_URL}>{h.ctaStart} <span class="btn-icon" set:html={moreIcons.arrowRight} /></a>
      </div>
    </div>
  </section>

  <!-- Hors ligne -->
  <section id={ids.offline} class="section offline">
    <div class="wrap split">
      <div>
        <p class="kicker kicker-light">{h.offlineEyebrow}</p>
        <h2>{h.offlineTitle}</h2>
        {h.offlineText.map((p) => <p>{p}</p>)}
      </div>
      <div class="offline-card" aria-hidden="true">
        <div class="oc-row"><span class="oc-dot off"></span>{h.offlineStates[0]}</div>
        <div class="oc-row"><span class="oc-dot sync"></span>{h.offlineStates[1]}</div>
        <div class="oc-row"><span class="oc-dot on"></span>{h.offlineStates[2]}</div>
      </div>
    </div>
  </section>

  <!-- Mise en route -->
  <section class="section section-tint">
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.stepsEyebrow}</p>
        <h2>{h.stepsTitle}</h2>
      </header>
      <ol class="steps">
        {t.steps.map((s) => <li><b>{s.title}</b><span>{s.text}</span></li>)}
      </ol>
    </div>
  </section>

  <!-- Installer : la carte de l'appareil du visiteur est mise en avant (petit script en bas de page). -->
  <section class="section install" data-install>
    <div class="wrap">
      <header class="section-head">
        <p class="kicker">{h.install.eyebrow}</p>
        <h2>{h.install.title}</h2>
        <p class="section-lead">{h.install.lead}</p>
      </header>
      <div class="install-grid">
        <ul class="install-cards">
          {
            h.install.devices.map((d, i) => (
              <li data-os={["android", "ios", "desktop"][i]}>
                <span class="install-yours">{h.install.yours}</span>
                <span class="install-icon" set:html={[moreIcons.deviceMobile, moreIcons.deviceMobile, deviceIcons.laptop][i]} />
                <b>{d.name}</b>
                <small>{d.where}</small>
                <ol>
                  {d.steps.map((st) => <li>{st}</li>)}
                </ol>
              </li>
            ))
          }
        </ul>
        <div class="install-open">
          <a class="btn btn-lg" href={APP_URL}>{h.install.open} <span class="btn-icon" set:html={moreIcons.arrowRight} /></a>
          <img src="/qr-app.svg" alt="" width="132" height="132" loading="lazy" />
          <small>{h.install.scan}</small>
        </div>
      </div>
      <p class="install-help">
        <span class="install-help-icon" set:html={icons.users} />
        <span><b>{h.install.help.title}</b> {h.install.help.text}</span>
      </p>
    </div>
  </section>

  <!-- Questions -->
  <section id={ids.faq} class="section">
    <div class="wrap faq-grid">
      <div>
        <p class="kicker">{h.faqEyebrow}</p>
        <h2>{h.faqTitle}</h2>
        <p class="section-lead">{h.faqLead}</p>
        <a class="btn btn-light" href={route(lang, "manual")}><span class="btn-icon" set:html={navIcons.book} />{h.faqManual}</a>
      </div>
      <div class="faq-list">
        {
          t.faqs.map((f, i) => (
            <details>
              <summary>
                <span class="faq-icon" set:html={faqIcons[i]} />
                <span>{f.q}</span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Appel final, sur photo -->
  <section class="final">
    <Photo name="marche" alt="" class="final-bg" sizes="100vw" />
    <div class="wrap final-inner">
      <h2>{h.finalTitle}</h2>
      <p>{h.finalText}</p>
      <a class="btn btn-lg btn-light" href={SIGNUP_URL}>{h.finalCta} <span class="btn-icon" set:html={moreIcons.arrowRight} /></a>
    </div>
  </section>
</Base>

<script>
  // Installer : met en avant la carte de l'appareil du visiteur.
  const install = document.querySelector<HTMLElement>("[data-install]");
  if (install) {
    const ua = navigator.userAgent;
    const ipad = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
    const os = /android/i.test(ua) ? "android" : /iphone|ipad|ipod/i.test(ua) || ipad ? "ios" : "desktop";
    install.querySelector(`[data-os="${os}"]`)?.classList.add("is-yours");
  }

  // BD : les cases apparaissent une à une quand la section arrive à l'écran.
  const comic = document.querySelector<HTMLElement>("[data-comic]");
  if (comic) {
    comic.classList.add("is-ready");
    new IntersectionObserver(
      ([entry], obs) => {
        if (entry.isIntersecting) {
          comic.classList.add("is-in");
          obs.disconnect();
        }
      },
      { threshold: 0.15 },
    ).observe(comic.querySelector(".comic-spark")!);
  }

  // Carrousel de l'accroche. Sans JavaScript, la première diapositive reste affichée seule.
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const bgs = [...root.querySelectorAll<HTMLElement>("[data-bg]")];
    const sectors = [...root.querySelectorAll<HTMLElement>("[data-sector]")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const head = root.querySelector<HTMLElement>("[data-head]")!;
    let fillAnim: Animation | undefined;
    const DELAY = 7000;
    let current = 0;
    let timer = 0;
    // Le défilement ne s'arrête jamais tout seul : seul le bouton pause l'arrête.
    let playing = true;

    root.querySelectorAll<HTMLElement>("[data-controls]").forEach((c) => (c.hidden = false));
    root.classList.add("is-ready");

    function show(i: number) {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === current;
        s.classList.toggle("is-active", on);
        if (on) s.removeAttribute("aria-hidden");
        else s.setAttribute("aria-hidden", "true");
        s.querySelectorAll<HTMLElement>("a").forEach((a) => (on ? a.removeAttribute("tabindex") : a.setAttribute("tabindex", "-1")));
      });
      bgs.forEach((b, k) => b.classList.toggle("is-active", k === current));
      sectors.forEach((el, k) => {
        el.classList.toggle("is-active", k === current);
        if (k === current) el.removeAttribute("aria-hidden");
        else el.setAttribute("aria-hidden", "true");
      });
      dots.forEach((d, k) => (k === current ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
      sweep();
      playToasts();
      restart();
    }
    // Notifications de la diapositive affichée : une nouvelle toutes les 1,6 s, trois au plus à l'écran (deux sur téléphone).
    let toastTimer = 0;
    function playToasts() {
      clearTimeout(toastTimer);
      root!.querySelectorAll(".toast").forEach((el) => el.classList.remove("in", "out"));
      const list = [...slides[current].querySelectorAll<HTMLElement>(".toast")];
      let n = 0;
      const next = () => {
        if (n < list.length) {
          list[n].classList.add("in");
          // Sur téléphone, deux notifications à la fois suffisent pour laisser voir l'écran de l'app.
          const max = matchMedia("(max-width: 860px)").matches ? 2 : 3;
          if (n >= max) list[n - max].classList.add("out");
          root!.classList.remove("is-beat");
          void root!.offsetWidth;
          root!.classList.add("is-beat");
          n++;
          toastTimer = window.setTimeout(next, 1600);
        }
      };
      toastTimer = window.setTimeout(next, 500);
    }
    function sweep() {
      root!.classList.remove("is-sweeping");
      void root!.offsetWidth;
      root!.classList.add("is-sweeping");
    }

    function restart() {
      clearTimeout(timer);
      // Le point avance sur la part de ligne de la diapositive en cours.
      const from = (current / slides.length) * 100;
      const to = ((current + 1) / slides.length) * 100;
      fillAnim?.cancel();
      if (playing) {
        fillAnim = head.animate([{ left: `${from}%` }, { left: `${to}%` }], { duration: DELAY, easing: "linear", fill: "forwards" });
        timer = window.setTimeout(() => show(current + 1), DELAY);
      } else {
        head.style.left = `${to}%`;
      }
    }
    function setPlaying(p: boolean) {
      playing = p;
      root!.classList.toggle("is-paused", !p);
      toggle.setAttribute("aria-label", p ? toggle.dataset.labelPause! : toggle.dataset.labelPlay!);
      if (p) restart();
      else {
        // En pause, le point s'arrête là où il en était.
        clearTimeout(timer);
        fillAnim?.pause();
      }
    }

    dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.dot))));
    root.querySelector("[data-prev]")!.addEventListener("click", () => show(current - 1));
    root.querySelector("[data-next]")!.addEventListener("click", () => show(current + 1));
    toggle.addEventListener("click", () => setPlaying(!playing));
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    // Glisser du doigt pour changer de diapositive.
    let startX = 0;
    let startY = 0;
    root.addEventListener("touchstart", (e) => ((startX = e.touches[0].clientX), (startY = e.touches[0].clientY)), { passive: true });
    root.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    setPlaying(playing);
    playToasts();
  }
</script>
