---
/**
 * Dépliant : une feuille A4 à l'italienne, recto-verso, pliée en trois (pli roulé), dans la langue demandée.
 * Extérieur, de gauche à droite : volet rabattu (avant / avec vitePOS), dos (QR code, contacts), couverture.
 * Intérieur : une vente en 3 gestes, ce que vous y gagnez, les tarifs. Textes : ceux de la brochure (`brochure` dans i18n),
 * le dépliant n'ajoute que des illustrations. Le volet rabattu fait 97 mm, les autres 100 mm,
 * pour que le pli ferme bien. PDF : imprimer cette page (voir CLAUDE.md, comme la brochure).
 */
import FollowQr from "../components/FollowQr.astro";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { APP_HOST, CONTACT, SITE_HOST } from "../data/content";
import { contactIcons, deviceIcons, icons, moreIcons } from "../data/icons";
import { dicts, PDF, type Lang } from "../i18n";
import "../styles/trifold.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const b = t.brochure;
const f = t.trifold;
const benefitIcons = [moreIcons.cash, icons.receipt, icons.package, icons.users, icons.lock, icons.chartBar];
const deviceList = [moreIcons.deviceMobile, deviceIcons.tablet, deviceIcons.laptop, moreIcons.printer];
/** Formule Pro mise en avant, les autres en liste. */
const pro = t.plans.list.find((p) => p.featured)!;
const others = t.plans.list.filter((p) => !p.featured);
---

<Base title={f.title} description={f.description} lang={lang} page="trifold">
  <div class="t-download t-noprint">
    <a class="btn" href={PDF[lang].trifold} download>{f.download}</a>
    <p>{f.screenNote}</p>
  </div>

  <div class="t-sheets">
    <p class="t-label t-noprint">{f.outsideLabel}</p>
    <!-- Extérieur : volet rabattu | dos | couverture -->
    <section class="t-sheet outside">
      <!-- Volet rabattu : le premier qu'on voit en ouvrant la couverture. -->
      <div class="panel flap">
        <h2 class="p-title">{b.storyTitle}</h2>
        <figure class="story before">
          <img src="/bd/bd-1.webp" alt={b.before.alt} width="1072" height="790" />
          <figcaption><b>{b.before.label}</b> {b.before.text}</figcaption>
        </figure>
        <span class="story-arrow" aria-hidden="true" set:html={moreIcons.arrowRight} />
        <figure class="story after">
          <img src="/bd/bd-8.webp" alt={b.after.alt} width="1072" height="790" />
          <figcaption><b>{b.after.label}</b> {b.after.text}</figcaption>
        </figure>
      </div>

      <!-- Dos : le QR code en grand et tous les contacts. -->
      <div class="panel back">
        <div class="back-brand">
          <span class="t-logo"><img src="/logo.svg" alt="" width="24" height="26" /></span>
          <span class="t-brand" translate="no">vitePOS</span>
        </div>
        <h2 class="p-title">{b.ctaTitle}</h2>
        <p class="back-lead">{b.ctaText}</p>
        <div class="back-qrs">
          <figure class="back-qr">
            <img src="/qr-app.svg" alt={`QR code : ${APP_HOST}`} width="120" height="120" />
            <figcaption><b>{b.qrLabel}</b><span translate="no">{APP_HOST}</span></figcaption>
          </figure>
          <FollowQr lang={lang} class="back-qr" />
        </div>
        <p class="back-price">{b.priceLine[0]} <b>{b.priceLine[1]}</b> {b.priceLine[2]}</p>
        <div class="visit">
          <b>{b.contactTitle}</b>
          <p>{b.contactText}</p>
        </div>
        <ul class="contacts">
          <li><span class="c-icon wa" set:html={contactIcons.whatsapp} /><div><small>{b.phoneLabel}</small><b translate="no">{CONTACT.phone}</b></div></li>
          {CONTACT.email && <li><span class="c-icon" set:html={contactIcons.mail} /><div><small>{b.emailLabel}</small><b translate="no">{CONTACT.email}</b></div></li>}
          <li><span class="c-icon" set:html={moreIcons.store} /><div><small>{b.siteLabel}</small><b translate="no">{SITE_HOST}</b></div></li>
        </ul>
        <p class="back-city"><span set:html={moreIcons.mapPin} />{t.cities}</p>
      </div>

      <!-- Couverture -->
      <div class="panel cover">
        <div class="cover-top">
          <span class="t-logo"><img src="/logo.svg" alt="" width="24" height="26" /></span>
          <span class="t-brand" translate="no">vitePOS</span>
        </div>
        <p class="cover-kicker">{b.signature}</p>
        <h1><span>{t.home.h1[0]}</span> <span>{t.home.h1[1]}</span> <span class="accent">{t.home.h1[2]}</span></h1>
        <p class="cover-lead">{b.lead}</p>
        <!-- Image écrite à la main (et non via Shot) : décodage immédiat, sinon Chrome l'imprime parfois en noir. -->
        <div class="cover-phone">
          <div class="frame-phone">
            <img src="/captures/tel-caisse.webp" alt={b.altCaisse} width="1170" height="2532" loading="eager" decoding="sync" fetchpriority="high" />
          </div>
        </div>
        <p class="cover-sticker"><b>{b.sticker[0]}</b><span>{b.sticker[1]}</span></p>
      </div>
    </section>

    <p class="t-label t-noprint">{f.insideLabel}</p>
    <!-- Intérieur : une vente en 3 gestes | fonctions | prix -->
    <section class="t-sheet inside">
      <div class="panel how">
        <h2 class="p-title">{b.howTitle}</h2>
        <ol class="how-steps">
          {
            b.how.map((s) => (
              <li>
                <b>{s.title}</b>
                <span>{s.text}</span>
              </li>
            ))
          }
        </ol>
        <div class="how-phones">
          <div class="back-phone"><Shot name="tel-accueil" device="tel" alt={b.altHome} eager /></div>
          <div class="front-phone"><Shot name="tel-ticket" device="tel" alt={t.home.shots.telTicket.alt} eager /></div>
        </div>
      </div>

      <div class="panel features">
        <h2 class="p-title">{b.benefitsTitle}</h2>
        <ul class="feat-list">
          {
            b.benefits.map((x, i) => (
              <li>
                <span class="f-icon" set:html={benefitIcons[i]} />
                <div>
                  <b>{x.title}</b>
                  <span>{x.text}</span>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="devices">
          <ul>
            {f.devices.map((d, i) => <li><span set:html={deviceList[i]} />{d}</li>)}
          </ul>
        </div>
      </div>

      <div class="panel price">
        <h2 class="p-title">{b.priceTitle}</h2>
        <div class="price-card">
          <p class="price-trial">{t.plans.popular} · {pro.trial}</p>
          <p class="price-plan">{pro.name} <span>{pro.phones}</span></p>
          <p class="price-amount"><b>{pro.price}</b> {t.plans.per}</p>
          <p class="price-yearly">{pro.yearly}</p>
          <ul>
            {b.proPoints.map((x) => <li><span set:html={moreIcons.check} />{x}</li>)}
          </ul>
        </div>
        <div class="others">
          <b>{b.otherPlans}</b>
          <ul>
            {others.map((p) => <li><strong>{p.name}</strong><span>{p.phones} · {p.trial}</span><em>{p.price}</em></li>)}
            <li><strong>{t.plans.custom.name}</strong><span>{t.plans.custom.phones} · {t.plans.custom.trial}</span><em>{t.plans.custom.price}</em></li>
          </ul>
        </div>
        <div class="price-cta">
          <img src="/qr-app.svg" alt={`QR code : ${APP_HOST}`} width="64" height="64" />
          <div>
            <b>{b.qrLabel}</b>
            <span translate="no">{APP_HOST}</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
