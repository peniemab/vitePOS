---
/**
 * Brochure commerciale : une feuille A5 recto-verso, à laisser au comptoir ou à envoyer par WhatsApp, dans la langue demandée.
 * Textes : `brochure` dans i18n (les mêmes que le dépliant, validés dans docs/TEXTES_DOCUMENTS.md).
 * Recto : signature, grand titre, téléphones, « Essai gratuit », une vente en 3 gestes, puis l'appel à l'action
 * (prix, QR code, WhatsApp). Verso : l'histoire avant / avec vitePOS (texte seul : dessins et pictogrammes sont dans le dépliant), ce que vous y gagnez,
 * les tarifs et les contacts avec le QR code « Suivez-nous ». PDF : imprimer cette page (voir CLAUDE.md, comme le manuel).
 */
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { APP_HOST, CONTACT, SITE_HOST } from "../data/content";
import { contactIcons, moreIcons } from "../data/icons";
import { dicts, PDF, type Lang } from "../i18n";
import "../styles/brochure.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const b = t.brochure;
/** Formule Pro mise en avant, les autres en liste. */
const pro = t.plans.list.find((p) => p.featured)!;
const others = t.plans.list.filter((p) => !p.featured);
---

<Base title={b.title} description={b.description} lang={lang} page="brochure">
  <div class="b-download b-noprint">
    <a class="btn" href={PDF[lang].brochure} download>{b.download}</a>
    <p>{b.screenNote}</p>
  </div>

  <div class="sheets">
    <!-- Recto -->
    <section class="sheet recto">
      <div class="r-cover">
        <header class="b-top">
          <span class="b-logo"><img src="/logo.svg" alt="" width="26" height="28" /></span>
          <span class="b-brand" translate="no">vitePOS</span>
          <span class="b-tag">{b.signature}</span>
        </header>
        <div class="r-hero">
          <div class="r-text">
            <h1><span>{t.home.h1[0]}</span> <span>{t.home.h1[1]}</span> <span class="accent">{t.home.h1[2]}</span></h1>
            <p class="r-lead">{b.lead}</p>
          </div>
          <div class="r-phones">
            <div class="back"><Shot name="tel-accueil" device="tel" alt={b.altHome} eager /></div>
            <div class="front"><Shot name="tel-caisse" device="tel" alt={b.altCaisse} eager /></div>
          </div>
        </div>
      </div>

      <p class="r-sticker"><b>{b.sticker[0]}</b><span>{b.sticker[1]}</span></p>
      <div class="r-how">
        <h2 class="r-how-title">{b.howTitle}</h2>
        <ol class="r-strengths">
          {
            b.how.map((s, i) => (
              <li>
                <span class="r-icon">{i + 1}</span>
                <b>{s.title}</b>
                <span>{s.text}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <footer class="r-cta">
        <div class="r-cta-main">
          <p class="r-cta-title">{b.ctaTitle}</p>
          <p class="r-cta-text">{b.ctaText}</p>
          <p class="r-price">
            {b.priceLine[0]} <b>{b.priceLine[1]}</b> {b.priceLine[2]}
          </p>
        </div>
        <div class="r-cta-side">
          <figure class="b-qr-box">
            <img class="b-qr" src="/qr-app.svg" alt={`QR code : ${APP_HOST}`} width="78" height="78" />
            <figcaption>{b.qrLabel}</figcaption>
          </figure>
        </div>
        <p class="r-wa">
          <span class="r-wa-icon" set:html={contactIcons.whatsapp} />
          <span>{b.phoneLabel}</span>
          <b translate="no">{CONTACT.phone}</b>
          <span class="r-url" translate="no">{APP_HOST}</span>
        </p>
      </footer>
    </section>

    <!-- Verso -->
    <section class="sheet verso">
      <!-- Sur l'A5, l'histoire est en texte seul : les dessins sont dans le dépliant A4. -->
      <h2 class="v-title">{b.storyTitle}</h2>
      <div class="v-story">
        <figure class="v-panel before">
          <figcaption><b>{b.before.label}</b> {b.before.text}</figcaption>
        </figure>
        <span class="v-arrow" aria-hidden="true" set:html={moreIcons.arrowRight} />
        <figure class="v-panel after">
          <figcaption><b>{b.after.label}</b> {b.after.text}</figcaption>
        </figure>
      </div>

      <h2 class="v-title small">{b.benefitsTitle}</h2>
      <ul class="v-benefits">
        {
          b.benefits.map((x) => (
            <li>
              <div>
                <b>{x.title}</b>
                <span>{x.text}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="v-bottom">
        <div class="v-price">
          <p class="v-price-trial">{t.plans.popular}</p>
          <p class="v-plan">{pro.name} <span>{pro.phones}</span></p>
          <p class="v-amount"><b>{pro.price}</b> {t.plans.per}, {pro.yearly}</p>
          <p class="v-trial">{pro.trial}</p>
          <ul class="v-points">
            {b.proPoints.map((x) => <li><span set:html={moreIcons.check} />{x}</li>)}
          </ul>
        </div>
        <div class="v-side">
          <p class="v-others-title">{b.otherPlans}</p>
          <ul class="v-others">
            {others.map((p) => <li><b>{p.name}</b><span>{p.phones} · {p.trial}</span><em>{p.price}</em></li>)}
            <li><b>{t.plans.custom.name}</b><span>{t.plans.custom.phones} · {t.plans.custom.trial}</span><em>{t.plans.custom.price}</em></li>
          </ul>
        </div>
      </div>

      <footer class="v-contact">
        <div class="v-contact-text">
          <p class="v-contact-title">{b.contactTitle}</p>
          <p>{b.contactText}</p>
          <dl>
            <div><dt><span set:html={contactIcons.whatsapp} />{b.phoneLabel}</dt><dd translate="no">{CONTACT.phone}</dd></div>
            {CONTACT.email && <div><dt><span set:html={contactIcons.mail} />{b.emailLabel}</dt><dd translate="no">{CONTACT.email}</dd></div>}
            <div><dt><span set:html={moreIcons.store} />{b.siteLabel}</dt><dd translate="no">{SITE_HOST}</dd></div>
          </dl>
        </div>
        <!-- « Suivez-nous » : le QR code ouvre /communaute (Instagram, Facebook), pas directement les réseaux. -->
        <figure class="v-community">
          <img src={lang === "fr" ? "/qr-communaute.svg" : "/qr-community-en.svg"} alt={t.community.qrAlt} width="96" height="96" />
          <figcaption>
            <b>{t.community.qrTitle}</b>
            <span class="v-community-icons"><span set:html={contactIcons.instagram} /><span set:html={contactIcons.facebook} /></span>
          </figcaption>
        </figure>
      </footer>
    </section>
  </div>
</Base>
