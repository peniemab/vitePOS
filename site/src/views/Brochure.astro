---
/**
 * Brochure commerciale : un livret de 4 pages A5, dans la langue demandée.
 * À l'écran et dans le PDF « brochure » : les 4 pages dans l'ordre de lecture (à envoyer par WhatsApp).
 * Pour l'imprimante : `scripts/impose-booklet.py` place ces pages 2 par face sur une feuille A4 recto-verso
 * (recto : page 4 | page 1, verso : page 2 | page 3) ; pliée en deux, la feuille donne le livret.
 * 1 couverture · 2 avant / avec vitePOS et une vente en 3 gestes · 3 ce que vous y gagnez · 4 tarifs, essai et contacts.
 * Textes : `brochure` dans i18n (les mêmes que le dépliant, validés dans docs/TEXTES_DOCUMENTS.md).
 * Tout le contenu reste à 9 mm des bords : les imprimantes de bureau n'impriment pas jusqu'au bord de la feuille.
 */
import FollowQr from "../components/FollowQr.astro";
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { APP_HOST, CONTACT, SITE_HOST } from "../data/content";
import { contactIcons, deviceIcons, icons, moreIcons } from "../data/icons";
import { qrImage } from "../data/qr";
import { dicts, PDF, type Lang } from "../i18n";
import "../styles/brochure.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const b = t.brochure;
const benefitIcons = [moreIcons.cash, icons.receipt, icons.package, icons.users, icons.lock, icons.chartBar];
const deviceList = [moreIcons.deviceMobile, deviceIcons.tablet, deviceIcons.laptop, moreIcons.printer];
/** Formule Pro mise en avant, les autres en liste. */
const pro = t.plans.list.find((p) => p.featured)!;
const others = t.plans.list.filter((p) => !p.featured);
---

<Base title={b.title} description={b.description} lang={lang} page="brochure">
  <div class="b-download b-noprint">
    <a class="btn" href={PDF[lang].brochure} download>{b.download}</a>
    <a class="b-print-link" href={PDF[lang].booklet} download>{b.printDownload}</a>
    <p>{b.screenNote}</p>
  </div>

  <div class="sheets">
    <!-- Page 1 : couverture -->
    <section class="sheet p-cover">
      <div class="c-block">
        <header class="b-top">
          <span class="b-logo"><img src="/logo.svg" alt="" width="26" height="28" /></span>
          <span class="b-brand" translate="no">vitePOS</span>
        </header>
        <p class="c-kicker">{b.signature}</p>
        <h1><span>{t.home.h1[0]}</span> <span>{t.home.h1[1]}</span> <span class="accent">{t.home.h1[2]}</span></h1>
        <p class="c-lead">{b.lead}</p>
        <div class="c-phones">
          <div class="back"><Shot name="tel-accueil" device="tel" alt={b.altHome} eager /></div>
          <div class="front"><Shot name="tel-caisse" device="tel" alt={b.altCaisse} eager /></div>
        </div>
        <p class="c-sticker"><b>{b.sticker[0]}</b><span>{b.sticker[1]}</span></p>
      </div>
      <!-- Bas de couverture : on peut commencer sans ouvrir le livret, ou aller voir le site. -->
      <div class="c-foot">
        <figure class="c-qr">
          <img src={qrImage(lang, "brochure")} alt={`QR code : ${APP_HOST}`} width="80" height="80" />
          <figcaption><b>{b.qrLabel}</b><span translate="no">{APP_HOST}</span></figcaption>
        </figure>
        <p class="c-site">
          <span>{b.siteCta}</span>
          <b translate="no">{SITE_HOST}</b>
        </p>
      </div>
    </section>

    <!-- Page 2 : avant / avec vitePOS, puis une vente en 3 gestes -->
    <section class="sheet p-story">
      <h2 class="b-title">{b.storyTitle}</h2>
      <div class="s-story">
        <figure class="s-panel before">
          <img src="/bd/bd-1.webp" alt={b.before.alt} width="1072" height="790" loading="eager" decoding="sync" />
          <figcaption><b>{b.before.label}</b> {b.before.text}</figcaption>
        </figure>
        <span class="s-arrow" aria-hidden="true" set:html={moreIcons.arrowRight} />
        <figure class="s-panel after">
          <img src="/bd/bd-8.webp" alt={b.after.alt} width="1072" height="790" loading="eager" decoding="sync" />
          <figcaption><b>{b.after.label}</b> {b.after.text}</figcaption>
        </figure>
      </div>

      <div class="s-how">
        <div>
          <h2 class="b-title">{b.howTitle}</h2>
          <ol class="s-steps">
            {
              b.how.map((s, i) => (
                <li>
                  <span class="s-num">{i + 1}</span>
                  <div>
                    <b>{s.title}</b>
                    <span>{s.text}</span>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="s-phone"><Shot name="tel-ticket" device="tel" alt={t.home.shots.telTicket.alt} eager /></div>
      </div>
    </section>

    <!-- Page 3 : ce que vous y gagnez -->
    <section class="sheet p-benefits">
      <h2 class="b-title">{b.benefitsTitle}</h2>
      <ul class="g-list">
        {
          b.benefits.map((x, i) => (
            <li>
              <span class="g-icon" set:html={benefitIcons[i]} />
              <div>
                <b>{x.title}</b>
                <span>{x.text}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <ul class="g-devices">
        {t.trifold.devices.map((d, i) => <li><span set:html={deviceList[i]} />{d}</li>)}
      </ul>
    </section>

    <!-- Page 4 (dos) : tarifs, essai gratuit et contacts -->
    <section class="sheet p-back">
      <h2 class="b-title">{b.priceTitle}</h2>
      <div class="k-plans">
        <div class="k-pro">
          <p class="k-badge">{t.plans.popular} · {pro.trial}</p>
          <p class="k-plan">{pro.name} <span>{pro.phones}</span></p>
          <p class="k-amount"><b>{pro.price}</b> {t.plans.per}</p>
          <p class="k-yearly">{pro.yearly}</p>
          <ul class="k-points">
            {b.proPoints.map((x) => <li><span set:html={moreIcons.check} />{x}</li>)}
          </ul>
        </div>
        <div class="k-others">
          <p class="k-others-title">{b.otherPlans}</p>
          <ul>
            {others.map((p) => <li><b>{p.name}</b><em>{p.price}</em><span>{p.phones} · {p.trial}</span></li>)}
            <li><b>{t.plans.custom.name}</b><em>{t.plans.custom.price}</em><span>{t.plans.custom.phones} · {t.plans.custom.trial}</span></li>
          </ul>
        </div>
      </div>

      <footer class="k-cta">
        <p class="k-cta-title">{b.ctaTitle}</p>
        <p class="k-cta-text">{b.ctaText}</p>
        <p class="k-price">{b.priceLine[0]} <b>{b.priceLine[1]}</b> {b.priceLine[2]}</p>
        <div class="k-qrs">
          <figure class="k-qr">
            <img src={qrImage(lang, "brochure")} alt={`QR code : ${APP_HOST}`} width="96" height="96" />
            <figcaption><b>{b.qrLabel}</b><span translate="no">{APP_HOST}</span></figcaption>
          </figure>
          <FollowQr lang={lang} support="brochure" class="k-qr" />
        </div>
        <div class="k-visit">
          <b>{b.contactTitle}</b>
          <p>{b.contactText}</p>
        </div>
        <ul class="k-contacts">
          <li><span class="wa" set:html={contactIcons.whatsapp} /><div><small>{b.phoneLabel}</small><b translate="no">{CONTACT.phone}</b></div></li>
          {CONTACT.email && <li><span set:html={contactIcons.mail} /><div><small>{b.emailLabel}</small><b translate="no">{CONTACT.email}</b></div></li>}
          <li><span set:html={moreIcons.store} /><div><small>{b.siteLabel}</small><b translate="no">{SITE_HOST}</b></div></li>
        </ul>
      </footer>
    </section>
  </div>
</Base>
