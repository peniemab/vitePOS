---
/**
 * Brochure commerciale : une feuille A4 recto-verso, à laisser au comptoir ou à envoyer par WhatsApp,
 * dans la langue demandée. Recto : l'accroche et les trois promesses. Verso : les fonctions, les secteurs,
 * comment démarrer. Le QR code ouvre l'app. PDF : imprimer cette page (voir CLAUDE.md, comme le manuel).
 */
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { APP_HOST, SITE_HOST } from "../data/content";
import { icons } from "../data/icons";
import { dicts, PDF, type Lang } from "../i18n";
import "../styles/brochure.css";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = dicts[lang];
const b = t.brochure;
---

<Base title={b.title} description={b.description} lang={lang} page="brochure">
  <div class="b-download b-noprint">
    <a class="btn" href={PDF[lang].brochure} download>{b.download}</a>
    <p>{b.screenNote}</p>
  </div>

  <div class="sheets">
    <!-- Recto -->
    <section class="sheet recto">
      <header class="b-top">
        <img src="/logo.svg" alt="" width="34" height="37" />
        <span class="b-brand">vite<b>POS</b></span>
        <span class="b-tag">{b.tag}</span>
      </header>

      <div class="b-hero">
        <div>
          <h1><span>{t.home.h1[0]}</span> <span>{t.home.h1[1]}</span> <span class="accent">{t.home.h1[2]}</span></h1>
          <p class="b-lead">{b.lead}</p>
          <ul class="b-strengths">
            {t.strengths.map((s) => <li><b>{s.title}</b> {s.text}</li>)}
          </ul>
        </div>
        <div class="b-phones">
          <div class="back"><Shot name="tel-accueil" device="tel" alt={b.altHome} eager /></div>
          <div class="front"><Shot name="tel-caisse" device="tel" alt={b.altCaisse} eager /></div>
        </div>
      </div>

      <ol class="b-promises">
        {
          t.promises.map((p, i) => (
            <li>
              <span class="num">0{i + 1}</span>
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>

      <footer class="b-cta">
        <div>
          <p class="b-cta-title">{b.ctaTitle}</p>
          <p>{b.ctaText}</p>
          <p class="b-url">{APP_HOST}</p>
        </div>
        <figure class="b-qr-box">
          <img class="b-qr" src="/qr-app.svg" alt={`QR code : ${APP_HOST}`} width="76" height="76" />
          <figcaption>{b.qrLabel}</figcaption>
        </figure>
      </footer>
    </section>

    <!-- Verso -->
    <section class="sheet verso">
      <h2 class="b-title">{b.featuresTitle}</h2>
      <div class="b-features">
        {
          t.features.map((f) => (
            <article>
              <div class="b-icon" set:html={icons[f.icon]} />
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="b-split">
        <div>
          <h2 class="b-title small">{b.sectorsTitle}</h2>
          <ul class="b-sectors">
            {t.sectors.map((s) => <li>{s}</li>)}
          </ul>
          <p class="b-cities">{t.cities}</p>
        </div>
        <div>
          <h2 class="b-title small">{b.stepsTitle}</h2>
          <ol class="b-steps">
            {/* A5 : les titres suffisent (le détail est sur le site et dans le manuel). */}
            {t.steps.map((s) => <li><b>{s.title}</b></li>)}
          </ol>
        </div>
      </div>

      <footer class="b-contact">
        <div>
          <b class="b-contact-title">{b.contactTitle}</b>
          <p>{b.website} <b>{SITE_HOST}</b></p>
        </div>
        <figure class="b-qr-box">
          <img class="b-qr" src="/qr-app.svg" alt={`QR code : ${APP_HOST}`} width="60" height="60" />
          <figcaption>{b.qrLabel}</figcaption>
        </figure>
      </footer>
    </section>
  </div>
</Base>
