# Port API Express (local / start:api) — jusqu’au portage des Route Handlers Next
PORT=3789

# Secret JWT — changer en production !
JWT_SECRET=changez-moi-en-production

# Durée de validité du token (ex. 30d, 7d, 12h)
JWT_EXPIRES=30d

# Neon Postgres (pooled connection string depuis le dashboard)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Front Next (build-time, exposé au navigateur) ---
# Laisser vide en local (rewrites Next → :3789).
# En prod split : NEXT_PUBLIC_API_URL=https://ton-api.example.com
# NEXT_PUBLIC_API_URL=
