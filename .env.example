# Port API + frontend en production (npm start après npm run build)
PORT=3789

# Secret JWT — changer en production !
JWT_SECRET=changez-moi-en-production

# Durée de validité du token (ex. 30d, 7d, 12h)
JWT_EXPIRES=30d

# Neon Postgres (pooled connection string depuis le dashboard)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
