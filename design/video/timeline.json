 "captions": [
  {
   "from": 0.001000000000000334,
   "text": "Votre téléphone devient la caisse de votre business"
  },
  {
   "from": 3.2140000000000004,
   "text": "1. Touchez les articles vendus"
  },
  {
   "from": 9.652,
   "text": "2. Le client paie en FC, en $ ou en mobile money"
  },
  {
   "from": 14.156,
   "text": "La monnaie à rendre est calculée pour vous"
  },
  {
   "from": 17.956000000000003,
   "text": "3. La vente est enregistrée, le ticket est prêt"
  },
  {
   "from": 22.465000000000003,
   "text": "Le stock baisse tout seul, à chaque vente"
  },
  {
   "from": 26.665,
   "text": "Pas de réseau ? Vous continuez à vendre"
  },
  {
   "from": 34.444,
   "text": "Le soir, vous savez ce qui doit être dans la caisse"
  }
