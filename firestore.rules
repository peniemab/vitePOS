rules_version = '2';

// Règles de sécurité Firestore de vitePOS (plusieurs boutiques dans le même projet).
// - Chaque compte Firebase = un employé. Ses droits viennent de boutiques/{id}/members/{uid}.
// - Créer une boutique fait de vous le propriétaire, actif d'office.
// - Rejoindre avec un code d'invitation crée un membre « vendeur » en attente :
//   seul le propriétaire peut le valider, changer son rôle ou le désactiver.
// - Rien n'est lisible en dehors de sa propre boutique.
//
// Modèle de données
// - users/{uid} : email, name, boutiqueId (boutique ouverte), createdAt, updatedAt
// - invitations/{code} : boutiqueId, createdBy, createdAt (jamais modifié)
// - boutiques/{bid} : name, currency (CDF|USD), inviteCode, ownerUid, usdRateCdf, usdRateUpdatedAt,
//   paperWidthMm, autoPrintTicket, createdAt, updatedAt
// - boutiques/{bid}/members/{uid} : email, name, role (proprietaire|gerant|vendeur),
//   status (pending|active|disabled), permissions {viewReports, editPrices, closeCash, manageStock}, inviteCode
// - boutiques/{bid}/products/{pid} : name, category, sellPrice, unit (u|kg|L), stock, alertThreshold,
//   barcode, favorite, archived, lastMovementId, createdAt, createdBy, updatedAt, updatedBy
// - boutiques/{bid}/productCosts/{pid} : buyPrice, updatedAt, updatedBy
// - boutiques/{bid}/stockMovements/{mid} : type, productIds[], deltas {pid: quantité signée},
//   names {pid: nom}, reason, uid, memberName, createdAt (heure serveur), clientAtMs, refId (vente)
// - boutiques/{bid}/sales/{sid} : uid, memberName, lines [{productId, name, unit, unitPrice, quantity, lineTotal}],
//   subtotal, discountPercent, discount, total, currency, payment {method, currency, rate, due, received, change},
//   status (validee|annulee), movementId, dayKey (AAAA-MM-JJ), createdAt, clientAtMs,
//   puis à l'annulation : cancelReason, cancelledBy, cancelledByName, cancelledAt, cancelMovementId
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function boutiquePath(bid) {
      return /databases/$(database)/documents/boutiques/$(bid);
    }
    function memberPath(bid, uid) {
      return /databases/$(database)/documents/boutiques/$(bid)/members/$(uid);
    }
    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }
    function isMember(bid) {
      return signedIn() && exists(memberPath(bid, request.auth.uid));
    }
    function me(bid) {
      return get(memberPath(bid, request.auth.uid)).data;
    }
    function isActive(bid) {
      return isMember(bid) && me(bid).status == 'active';
    }
    function hasRole(bid, roles) {
      return isActive(bid) && me(bid).role in roles;
    }
    function validInviteCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }
    function validName(n) {
      return n is string && n.size() <= 80;
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Fiche du compte ----------

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // La boutique ouverte doit être une boutique dont on est membre (ou aucune).
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.get('name', ''))
        && (request.resource.data.get('boutiqueId', '') == ''
            || existsAfter(memberPath(request.resource.data.boutiqueId, uid)));
    }

    // ---------- Codes d'invitation ----------

    // Lecture d'un code précis seulement (pas de liste), création avec la boutique, jamais modifié.
    match /invitations/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && validInviteCode(code)
        && !exists(boutiquePath(request.resource.data.boutiqueId))
        && getAfter(boutiquePath(request.resource.data.boutiqueId)).data.ownerUid == request.auth.uid
        && getAfter(boutiquePath(request.resource.data.boutiqueId)).data.inviteCode == code
        && request.resource.data.createdBy == request.auth.uid;
    }

    // ---------- Boutiques ----------

    match /boutiques/{bid} {
      // Un membre en attente peut lire le nom de la boutique qu'il a demandé à rejoindre.
      allow get: if isMember(bid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validInviteCode(request.resource.data.inviteCode)
        && validName(request.resource.data.name)
        && request.resource.data.currency in ['CDF', 'USD']
        && getAfter(memberPath(bid, request.auth.uid)).data.role == 'proprietaire'
        && getAfter(invitationPath(request.resource.data.inviteCode)).data.boutiqueId == bid;

      // Propriétaire : tous les réglages, sauf le propriétaire et le code d'invitation.
      allow update: if hasRole(bid, ['proprietaire'])
        && !changes().hasAny(['ownerUid', 'inviteCode', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.currency in ['CDF', 'USD'];

      // Gérant : seulement le taux du jour.
      allow update: if hasRole(bid, ['gerant'])
        && changes().hasOnly(['usdRateCdf', 'usdRateUpdatedAt', 'updatedAt'])
        && request.resource.data.usdRateCdf is number
        && request.resource.data.usdRateCdf > 0;

      // ---------- Membres ----------

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isActive(bid));
        allow list: if isActive(bid);

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && validName(request.resource.data.name)
          && (
            // Demande d'adhésion avec un code valide pour cette boutique.
            (request.resource.data.role == 'vendeur'
              && request.resource.data.status == 'pending'
              && validInviteCode(request.resource.data.inviteCode)
              && get(invitationPath(request.resource.data.inviteCode)).data.boutiqueId == bid)
            // Propriétaire, créé en même temps que la boutique.
            || (request.resource.data.role == 'proprietaire'
              && request.resource.data.status == 'active'
              && !exists(boutiquePath(bid))
              && getAfter(boutiquePath(bid)).data.ownerUid == uid)
          );

        // Propriétaire : valider, changer le rôle, ajuster les droits, désactiver.
        // Il ne peut ni nommer un autre propriétaire, ni se retirer ses propres droits.
        allow update: if hasRole(bid, ['proprietaire'])
          && changes().hasOnly(['role', 'status', 'permissions', 'updatedAt'])
          && request.resource.data.status in ['pending', 'active', 'disabled']
          && (
            (uid != request.auth.uid && request.resource.data.role in ['gerant', 'vendeur'])
            || (uid == request.auth.uid
                && request.resource.data.role == 'proprietaire'
                && request.resource.data.status == 'active')
          );

        // Chacun peut changer son propre nom.
        allow update: if signedIn()
          && request.auth.uid == uid
          && changes().hasOnly(['name', 'updatedAt'])
          && validName(request.resource.data.name);
      }

      // ---------- Produits et stock ----------
      // Le stock ne varie qu'avec un mouvement créé dans la même écriture : le produit pointe
      // vers ce mouvement (lastMovementId) et la variation doit être égale à celle du mouvement.

      match /products/{pid} {
        allow read: if isActive(bid);

        allow create: if isActive(bid)
          && can(bid, 'editPrices')
          && request.resource.data.keys().hasOnly(catalogFields().concat(['stock', 'lastMovementId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']))
          && validProduct(request.resource.data)
          && request.resource.data.archived == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && (request.resource.data.stock == 0
              || movementMatches(bid, pid, request.resource.data.stock));

        allow update: if isActive(bid)
          && changes().hasOnly(catalogFields().concat(['stock', 'lastMovementId', 'updatedAt', 'updatedBy']))
          && request.resource.data.updatedBy == request.auth.uid
          && validProduct(request.resource.data)
          && (!changes().hasAny(catalogFields()) || can(bid, 'editPrices'))
          && (!changes().hasAny(['stock', 'lastMovementId'])
              || movementMatches(bid, pid, request.resource.data.stock - resource.data.stock));
      }

      // Prix d'achat : séparés des fiches pour que les vendeurs ne voient pas les marges.
      match /productCosts/{pid} {
        allow read: if can(bid, 'editPrices') || can(bid, 'viewReports');
        allow create, update: if can(bid, 'editPrices')
          && request.resource.data.keys().hasOnly(['buyPrice', 'updatedAt', 'updatedBy'])
          && request.resource.data.buyPrice is number
          && request.resource.data.buyPrice >= 0
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // Journal des mouvements : création seulement, jamais modifié ni supprimé.
      match /stockMovements/{mid} {
        allow read: if isActive(bid);
        allow create: if isActive(bid)
          && request.resource.data.keys().hasOnly(['type', 'productIds', 'deltas', 'names', 'reason', 'uid', 'memberName', 'createdAt', 'clientAtMs', 'refId'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.productIds is list
          && request.resource.data.productIds.size() > 0
          && request.resource.data.productIds.size() <= 250
          && request.resource.data.deltas is map
          && request.resource.data.deltas.keys().hasAll(request.resource.data.productIds)
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 200
          && (
            // Saisie manuelle : réservée à ceux qui gèrent le stock.
            (request.resource.data.type in ['reappro', 'casse', 'don', 'correction'] && can(bid, 'manageStock'))
            // Vente : la vente citée est créée dans la même écriture et pointe vers ce mouvement.
            || (request.resource.data.type == 'vente'
                && saleAfter(bid).movementId == mid
                && saleAfter(bid).createdAt == request.time)
            // Annulation : la vente citée est annulée dans la même écriture par ce mouvement.
            || (request.resource.data.type == 'annulation'
                && saleAfter(bid).cancelMovementId == mid
                && saleAfter(bid).cancelledAt == request.time)
          );
        // Les mouvements d'inventaire arrivent avec l'étape 5.
      }

      // ---------- Ventes ----------
      // Chaque vendeur actif encaisse en son nom. Une vente n'est jamais supprimée :
      // elle peut seulement être annulée, dans les 24 heures, par un gérant ou le propriétaire.

      match /sales/{sid} {
        allow read: if isActive(bid);

        allow create: if isActive(bid)
          && request.resource.data.keys().hasOnly(['uid', 'memberName', 'lines', 'subtotal', 'discountPercent', 'discount', 'total', 'currency', 'payment', 'status', 'movementId', 'dayKey', 'createdAt', 'clientAtMs'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.memberName is string
          && request.resource.data.status == 'validee'
          && request.resource.data.createdAt == request.time
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 200
          && request.resource.data.subtotal is number
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= request.resource.data.subtotal
          && request.resource.data.discountPercent is number
          && request.resource.data.discountPercent >= 0
          && request.resource.data.discountPercent <= 100
          && (request.resource.data.discountPercent == 0 || can(bid, 'editPrices'))
          && request.resource.data.currency in ['CDF', 'USD']
          && request.resource.data.payment is map
          && request.resource.data.payment.method in ['especes', 'mobile_money']
          && request.resource.data.movementId is string
          && request.resource.data.dayKey is string;

        allow update: if can(bid, 'editPrices')
          && resource.data.status == 'validee'
          && changes().hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledByName', 'cancelledAt', 'cancelMovementId'])
          && request.resource.data.status == 'annulee'
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() <= 200
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.cancelMovementId is string
          && request.time < resource.data.createdAt + duration.value(1, 'd');
      }
    }

    // La vente citée par le mouvement en cours d'écriture, telle qu'elle sera après l'écriture.
    function saleAfter(bid) {
      return getAfter(/databases/$(database)/documents/boutiques/$(bid)/sales/$(request.resource.data.refId)).data;
    }

    function catalogFields() {
      return ['name', 'category', 'sellPrice', 'unit', 'alertThreshold', 'barcode', 'favorite', 'archived'];
    }

    function validProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.category is string && p.category.size() <= 60
        && p.sellPrice is number && p.sellPrice >= 0
        && p.unit in ['u', 'kg', 'L']
        && p.stock is number
        && p.alertThreshold is number && p.alertThreshold >= 0
        && p.barcode is string && p.barcode.size() <= 64
        && p.favorite is bool
        && p.archived is bool;
    }

    // Le mouvement cité par le produit est créé dans cette même écriture et porte la même variation.
    function movementMatches(bid, pid, delta) {
      let mv = getAfter(/databases/$(database)/documents/boutiques/$(bid)/stockMovements/$(request.resource.data.lastMovementId)).data;
      return request.resource.data.lastMovementId is string
        && request.resource.data.lastMovementId != (resource == null ? '' : resource.data.get('lastMovementId', ''))
        && mv.createdAt == request.time
        && pid in mv.deltas
        && math.abs(delta - mv.deltas[pid]) < 0.0005;
    }

    // Droit effectif : le propriétaire a tout ; sinon l'ajustement du propriétaire, ou la valeur du rôle.
    function can(bid, perm) {
      let m = get(/databases/$(database)/documents/boutiques/$(bid)/members/$(request.auth.uid)).data;
      return isActive(bid)
        && (m.role == 'proprietaire'
            || m.get('permissions', {}).get(perm, m.role == 'gerant') == true);
    }
  }
}
