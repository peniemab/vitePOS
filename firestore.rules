rules_version = '2';

// Règles de sécurité Firestore de vitePOS (plusieurs boutiques dans le même projet).
// - Chaque compte Firebase = un employé. Ses droits viennent de boutiques/{id}/members/{uid}.
// - Créer une boutique fait de vous le propriétaire, actif d'office.
// - Rejoindre avec un code d'invitation crée un membre « vendeur » en attente :
//   seul le propriétaire peut le valider, changer son rôle ou le désactiver.
// - Rien n'est lisible en dehors de sa propre boutique.
//
// Modèle de données
// - users/{uid} : email, name, boutiqueId (boutique ouverte), createdAt, updatedAt
// - invitations/{code} : boutiqueId, createdBy, createdAt (jamais modifié)
// - boutiques/{bid} : name, currency (CDF|USD|EUR), inviteCode, ownerUid, usdRateCdf, usdRateUpdatedAt,
//   eurRateCdf, eurRateUpdatedAt,
//   paperWidthMm, autoPrintTicket, plan (boutique|pro|supermarche), billingCycle (mensuel|annuel),
//   trialEndsAt, paidUntil (fixé par l'éditeur seulement), createdAt, updatedAt
// - boutiques/{bid}/members/{uid} : email, name, role (proprietaire|gerant|vendeur),
//   status (pending|active|disabled), permissions {viewReports, editPrices, closeCash, manageStock}, inviteCode
// - boutiques/{bid}/products/{pid} : sku (code article, unique dans la boutique), packs (emballages :
//   [{id, name, barcode, units, price}], 5 au plus ; le stock reste compté à l'unité), name, category, sellPrice, unit (u|kg|L), stock, alertThreshold,
//   barcode, favorite, archived, lastMovementId, createdAt, createdBy, updatedAt, updatedBy
// - boutiques/{bid}/productCosts/{pid} : buyPrice, updatedAt, updatedBy
// - boutiques/{bid}/stockMovements/{mid} : type, productIds[], deltas {pid: quantité signée},
//   names {pid: nom}, reason, uid, memberName, createdAt (heure serveur), clientAtMs, refId (vente)
// - boutiques/{bid}/sales/{sid} : uid, memberName, lines [{productId, name, unit, unitPrice, quantity, lineTotal, et pour un emballage packId, packName, packUnits}],
//   subtotal, discountPercent, discount, total, currency, payment {method, currency, rate, due, received, change},
//   clientId, clientName ("" sans client), status (validee|annulee), movementId, dayKey (AAAA-MM-JJ),
//   createdAt, clientAtMs, puis à l'annulation : cancelReason, cancelledBy, cancelledByName, cancelledAt,
//   cancelMovementId
// - boutiques/{bid}/clients/{cid} : name, phone, notes, purchaseCount, totalSpent, lastPurchaseAt,
//   createdAt, createdBy, updatedAt, updatedBy (les totaux suivent les ventes par increment)
// - boutiques/{bid}/expenses/{eid} : amount, currency, category, description, fromTill (payée en caisse),
//   status (validee|annulee), uid, memberName, dayKey, createdAt, clientAtMs,
//   puis à l'annulation : cancelledBy, cancelledByName, cancelledAt
// - boutiques/{bid}/cashDays/{AAAA-MM-JJ} : status (open|closed), openingFloat {CDF, USD}, openedBy,
//   openedByName, openedAt, puis à la clôture : closing {counted, expected, variance : {CDF, USD},
//   salesCount, revenue, notes}, closedBy, closedByName, closedAt
// - boutiques/{bid}/inventories/{iid} : label, status (en_cours|validee|annulee), createdBy, createdByName,
//   createdAt, clientAtMs, puis à la fin : validatedBy, validatedByName, validatedAt, gapsCount,
//   missingValue, surplusValue
// - boutiques/{bid}/inventories/{iid}/lines/{pid} : name, unit, theoretical (stock au moment du comptage),
//   counted, countedBy, countedByName, countedAt
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function boutiquePath(bid) {
      return /databases/$(database)/documents/boutiques/$(bid);
    }
    function memberPath(bid, uid) {
      return /databases/$(database)/documents/boutiques/$(bid)/members/$(uid);
    }
    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }
    function isMember(bid) {
      return signedIn() && exists(memberPath(bid, request.auth.uid));
    }
    function me(bid) {
      return get(memberPath(bid, request.auth.uid)).data;
    }
    function isActive(bid) {
      return isMember(bid) && me(bid).status == 'active';
    }
    function hasRole(bid, roles) {
      return isActive(bid) && me(bid).role in roles;
    }
    function validInviteCode(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}$');
    }
    function validName(n) {
      return n is string && n.size() <= 80;
    }
    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Fiche du compte ----------

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // La boutique ouverte doit être une boutique dont on est membre (ou aucune).
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.get('name', ''))
        && (request.resource.data.get('boutiqueId', '') == ''
            || existsAfter(memberPath(request.resource.data.boutiqueId, uid)));
    }

    // ---------- Codes d'invitation ----------

    // Lecture d'un code précis seulement (pas de liste), création avec la boutique, jamais modifié.
    match /invitations/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && validInviteCode(code)
        && !exists(boutiquePath(request.resource.data.boutiqueId))
        && getAfter(boutiquePath(request.resource.data.boutiqueId)).data.ownerUid == request.auth.uid
        && getAfter(boutiquePath(request.resource.data.boutiqueId)).data.inviteCode == code
        && request.resource.data.createdBy == request.auth.uid;
    }

    // ---------- Boutiques ----------

    match /boutiques/{bid} {
      // Un membre en attente peut lire le nom de la boutique qu'il a demandé à rejoindre.
      allow get: if isMember(bid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validInviteCode(request.resource.data.inviteCode)
        && validName(request.resource.data.name)
        && request.resource.data.currency in ['CDF', 'USD', 'EUR']
        && request.resource.data.plan in ['boutique', 'pro', 'supermarche']
        && request.resource.data.billingCycle == 'mensuel'
        && !('paidUntil' in request.resource.data)
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.trialEndsAt > request.time + duration.value(29, 'd')
        && request.resource.data.trialEndsAt < request.time + duration.value(31, 'd')
        && getAfter(memberPath(bid, request.auth.uid)).data.role == 'proprietaire'
        && getAfter(invitationPath(request.resource.data.inviteCode)).data.boutiqueId == bid;

      // Propriétaire : tous les réglages, sauf le propriétaire, le code d'invitation et l'abonnement.
      // L'abonnement (trialEndsAt, paidUntil, billingCycle) est fixé par l'éditeur de vitePOS ;
      // le propriétaire peut seulement changer de formule pendant l'essai.
      allow update: if hasRole(bid, ['proprietaire'])
        && !changes().hasAny(['ownerUid', 'inviteCode', 'createdAt', 'trialEndsAt', 'paidUntil', 'billingCycle'])
        && (!changes().hasAny(['plan'])
            || (request.resource.data.plan in ['boutique', 'pro', 'supermarche']
                && resource.data.get('paidUntil', null) == null
                && request.time < trialEndOf(resource.data)))
        && validName(request.resource.data.name)
        && request.resource.data.currency in ['CDF', 'USD', 'EUR']
        // Taux du jour (fixés par le propriétaire seulement) : FC pour 1 $ et pour 1 €.
        && request.resource.data.usdRateCdf is number
        && request.resource.data.usdRateCdf > 0
        && request.resource.data.get('eurRateCdf', 0) is number
        && request.resource.data.get('eurRateCdf', 0) >= 0;

      // ---------- Membres ----------

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isActive(bid));
        allow list: if isActive(bid);

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == request.auth.token.email
          && validName(request.resource.data.name)
          && (
            // Demande d'adhésion avec un code valide pour cette boutique.
            (request.resource.data.role == 'vendeur'
              && request.resource.data.status == 'pending'
              && validInviteCode(request.resource.data.inviteCode)
              && get(invitationPath(request.resource.data.inviteCode)).data.boutiqueId == bid)
            // Propriétaire, créé en même temps que la boutique.
            || (request.resource.data.role == 'proprietaire'
              && request.resource.data.status == 'active'
              && !exists(boutiquePath(bid))
              && getAfter(boutiquePath(bid)).data.ownerUid == uid)
          );

        // Propriétaire : valider, changer le rôle, ajuster les droits, désactiver.
        // Il ne peut ni nommer un autre propriétaire, ni se retirer ses propres droits.
        allow update: if hasRole(bid, ['proprietaire'])
          && changes().hasOnly(['role', 'status', 'permissions', 'updatedAt'])
          && request.resource.data.status in ['pending', 'active', 'disabled']
          && (
            (uid != request.auth.uid && request.resource.data.role in ['gerant', 'vendeur'])
            || (uid == request.auth.uid
                && request.resource.data.role == 'proprietaire'
                && request.resource.data.status == 'active')
          );

        // Chacun peut changer son propre nom.
        allow update: if signedIn()
          && request.auth.uid == uid
          && changes().hasOnly(['name', 'updatedAt'])
          && validName(request.resource.data.name);
      }

      // ---------- Produits et stock ----------
      // Le stock ne varie qu'avec un mouvement créé dans la même écriture : le produit pointe
      // vers ce mouvement (lastMovementId) et la variation doit être égale à celle du mouvement.

      match /products/{pid} {
        allow read: if isActive(bid);

        allow create: if notBlocked(bid)
          && isActive(bid)
          && can(bid, 'editPrices')
          && request.resource.data.keys().hasOnly(catalogFields().concat(['stock', 'lastMovementId', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy']))
          && validProduct(request.resource.data)
          && request.resource.data.archived == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && (request.resource.data.stock == 0
              || movementMatches(bid, pid, request.resource.data.stock));

        allow update: if notBlocked(bid)
          && isActive(bid)
          && changes().hasOnly(catalogFields().concat(['stock', 'lastMovementId', 'updatedAt', 'updatedBy']))
          && request.resource.data.updatedBy == request.auth.uid
          && validProduct(request.resource.data)
          && (!changes().hasAny(catalogFields()) || can(bid, 'editPrices'))
          && (!changes().hasAny(['stock', 'lastMovementId'])
              || movementMatches(bid, pid, request.resource.data.stock - resource.data.stock));
      }

      // Prix d'achat : séparés des fiches pour que les vendeurs ne voient pas les marges.
      match /productCosts/{pid} {
        allow read: if can(bid, 'editPrices') || can(bid, 'viewReports');
        allow create, update: if notBlocked(bid)
          && can(bid, 'editPrices')
          && request.resource.data.keys().hasOnly(['buyPrice', 'updatedAt', 'updatedBy'])
          && request.resource.data.buyPrice is number
          && request.resource.data.buyPrice >= 0
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // Journal des mouvements : création seulement, jamais modifié ni supprimé.
      match /stockMovements/{mid} {
        allow read: if isActive(bid);
        allow create: if notBlocked(bid)
          && isActive(bid)
          && request.resource.data.keys().hasOnly(['type', 'productIds', 'deltas', 'names', 'reason', 'uid', 'memberName', 'createdAt', 'clientAtMs', 'refId'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.productIds is list
          && request.resource.data.productIds.size() > 0
          && request.resource.data.productIds.size() <= 250
          && request.resource.data.deltas is map
          && request.resource.data.deltas.keys().hasAll(request.resource.data.productIds)
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 200
          && (
            // Saisie manuelle : réservée à ceux qui gèrent le stock.
            (request.resource.data.type in ['reappro', 'casse', 'don', 'correction', 'inventaire'] && can(bid, 'manageStock'))
            // Vente : la vente citée est créée dans la même écriture et pointe vers ce mouvement.
            || (request.resource.data.type == 'vente'
                && saleAfter(bid).movementId == mid
                && saleAfter(bid).createdAt == request.time)
            // Annulation : la vente citée est annulée dans la même écriture par ce mouvement.
            || (request.resource.data.type == 'annulation'
                && saleAfter(bid).cancelMovementId == mid
                && saleAfter(bid).cancelledAt == request.time)
          );
      }

      // ---------- Ventes ----------
      // Chaque vendeur actif encaisse en son nom. Une vente n'est jamais supprimée :
      // elle peut seulement être annulée, dans les 24 heures, par un gérant ou le propriétaire.

      match /sales/{sid} {
        allow read: if isActive(bid);

        allow create: if notBlocked(bid)
          && isActive(bid)
          && request.resource.data.keys().hasOnly(['uid', 'memberName', 'lines', 'subtotal', 'discountPercent', 'discount', 'total', 'currency', 'payment', 'clientId', 'clientName', 'inStats', 'status', 'movementId', 'dayKey', 'createdAt', 'clientAtMs'])
          && request.resource.data.get('inStats', true) is bool
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() <= 64
          && request.resource.data.clientName is string
          && request.resource.data.clientName.size() <= 80
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.memberName is string
          && request.resource.data.status == 'validee'
          && request.resource.data.createdAt == request.time
          && request.resource.data.lines is list
          && request.resource.data.lines.size() > 0
          && request.resource.data.lines.size() <= 200
          && request.resource.data.subtotal is number
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= request.resource.data.subtotal
          && request.resource.data.discountPercent is number
          && request.resource.data.discountPercent >= 0
          && request.resource.data.discountPercent <= 100
          && (request.resource.data.discountPercent == 0 || can(bid, 'editPrices'))
          && request.resource.data.currency in ['CDF', 'USD', 'EUR']
          && request.resource.data.payment is map
          && request.resource.data.payment.method in ['especes', 'mobile_money']
          && request.resource.data.movementId is string
          && request.resource.data.dayKey is string;

        allow update: if notBlocked(bid)
          && can(bid, 'editPrices')
          && resource.data.status == 'validee'
          && changes().hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledByName', 'cancelledAt', 'cancelMovementId'])
          && request.resource.data.status == 'annulee'
          && request.resource.data.cancelReason is string
          && request.resource.data.cancelReason.size() <= 200
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.cancelMovementId is string
          && request.time < resource.data.createdAt + duration.value(1, 'd');
      }

      // ---------- Clients ----------
      // Tout membre actif peut créer ou corriger un client (souvent à la caisse). Les totaux d'achats
      // suivent les ventes par increment ; ils ne sont pas recoupés avec les ventes (budget de get() serré).

      match /clients/{cid} {
        allow read: if isActive(bid);

        allow create: if notBlocked(bid)
          && isActive(bid)
          && request.resource.data.keys().hasOnly(['name', 'phone', 'notes', 'purchaseCount', 'totalSpent', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && validClient(request.resource.data)
          && request.resource.data.purchaseCount == 0
          && request.resource.data.totalSpent == 0
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if notBlocked(bid)
          && isActive(bid)
          && changes().hasOnly(['name', 'phone', 'notes', 'purchaseCount', 'totalSpent', 'lastPurchaseAt', 'updatedAt', 'updatedBy'])
          && validClient(request.resource.data)
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // ---------- Dépenses ----------
      // Tout membre actif note une dépense en son nom ; seul celui qui clôture la caisse peut l'annuler.

      match /expenses/{eid} {
        allow read: if isActive(bid);

        allow create: if notBlocked(bid)
          && isActive(bid)
          && request.resource.data.keys().hasOnly(['amount', 'currency', 'category', 'description', 'fromTill', 'status', 'inStats', 'uid', 'memberName', 'dayKey', 'createdAt', 'clientAtMs'])
          && request.resource.data.get('inStats', true) is bool
          && validExpense(request.resource.data)
          && request.resource.data.status == 'validee'
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;

        allow update: if notBlocked(bid)
          && can(bid, 'closeCash')
          && resource.data.status == 'validee'
          && changes().hasOnly(['status', 'cancelledBy', 'cancelledByName', 'cancelledAt'])
          && request.resource.data.status == 'annulee'
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancelledAt == request.time;
      }

      // ---------- Compteurs mensuels ----------
      // Ventes et dépenses de chaque mois, par devise, pour le graphique des six derniers mois.
      // Mis à jour par increment() avec chaque vente, annulation ou dépense (donc par tout membre actif) ;
      // lus seulement par ceux qui voient les rapports.
      match /monthStats/{month} {
        allow read: if can(bid, 'viewReports');

        allow create, update: if notBlocked(bid)
          && isActive(bid)
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['sales', 'saleCount', 'expenses'])
          && validMonthMoney(request.resource.data.get('sales', {}))
          && validMonthMoney(request.resource.data.get('expenses', {}))
          && request.resource.data.get('saleCount', 0) is number;
      }

      // ---------- Inventaires ----------
      // Compter et valider sont réservés à ceux qui gèrent le stock. Les écarts sont appliqués par des
      // mouvements « inventaire » ; un inventaire terminé (validé ou annulé) ne change plus.

      match /inventories/{iid} {
        allow read: if isActive(bid);

        allow create: if notBlocked(bid)
          && can(bid, 'manageStock')
          && request.resource.data.keys().hasOnly(['label', 'status', 'createdBy', 'createdByName', 'createdAt', 'clientAtMs'])
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 80
          && request.resource.data.status == 'en_cours'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.clientAtMs is number;

        allow update: if notBlocked(bid)
          && can(bid, 'manageStock')
          && resource.data.status == 'en_cours'
          && request.resource.data.status in ['validee', 'annulee']
          && changes().hasOnly(['status', 'validatedBy', 'validatedByName', 'validatedAt', 'gapsCount', 'missingValue', 'surplusValue'])
          && request.resource.data.validatedBy == request.auth.uid
          && request.resource.data.validatedAt == request.time;

        match /lines/{pid} {
          allow read: if isActive(bid);
          allow create, update: if notBlocked(bid)
          && can(bid, 'manageStock')
            && get(/databases/$(database)/documents/boutiques/$(bid)/inventories/$(iid)).data.status == 'en_cours'
            && request.resource.data.keys().hasOnly(['name', 'unit', 'theoretical', 'counted', 'countedBy', 'countedByName', 'countedAt'])
            && request.resource.data.name is string
            && request.resource.data.name.size() <= 120
            && request.resource.data.unit in ['u', 'kg', 'L']
            && request.resource.data.theoretical is number
            && request.resource.data.counted is number
            && request.resource.data.counted >= 0
            && request.resource.data.countedBy == request.auth.uid
            && request.resource.data.countedAt == request.time;
        }
      }

      // ---------- Journées de caisse ----------
      // Un document par jour. Tout membre actif note le fond de caisse ; la clôture est réservée à
      // ceux qui ont le droit de clôturer, et une journée clôturée ne change plus.

      match /cashDays/{day} {
        allow read: if isActive(bid);

        allow create: if notBlocked(bid)
          && isActive(bid)
          && validDayKey(day)
          && validCashDay(request.resource.data)
          && ((request.resource.data.status == 'open' && openingSigned())
              || (request.resource.data.status == 'closed' && can(bid, 'closeCash') && closingSigned()));

        allow update: if notBlocked(bid)
          && isActive(bid)
          && resource.data.status == 'open'
          && validCashDay(request.resource.data)
          && ((request.resource.data.status == 'open'
                && changes().hasOnly(['openingFloat', 'openedBy', 'openedByName', 'openedAt'])
                && openingSigned())
              || (request.resource.data.status == 'closed'
                && can(bid, 'closeCash')
                && changes().hasOnly(['status', 'openingFloat', 'closing', 'closedBy', 'closedByName', 'closedAt'])
                && closingSigned()));
      }
    }

    function validClient(c) {
      return c.name is string && c.name.size() > 0 && c.name.size() <= 80
        && c.phone is string && c.phone.size() <= 30
        && c.notes is string && c.notes.size() <= 500
        && c.purchaseCount is number
        && c.totalSpent is number;
    }

    function validDayKey(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validExpense(e) {
      return e.amount is number && e.amount > 0
        && e.currency in ['CDF', 'USD', 'EUR']
        && e.category in ['transport', 'fournitures', 'loyer', 'communication', 'salaires', 'autres']
        && e.description is string && e.description.size() <= 200
        && e.fromTill is bool
        && e.memberName is string && e.memberName.size() <= 80
        && validDayKey(e.dayKey)
        && e.clientAtMs is number;
    }

    function validMoney2(m) {
      return m is map && m.keys().hasOnly(['CDF', 'USD', 'EUR'])
        && m.CDF is number && m.USD is number
        && m.get('EUR', 0) is number;
    }

    function validCashDay(d) {
      return d.keys().hasOnly(['status', 'openingFloat', 'openedBy', 'openedByName', 'openedAt', 'closing', 'closedBy', 'closedByName', 'closedAt'])
        && d.status in ['open', 'closed']
        && validMoney2(d.openingFloat)
        && d.openingFloat.CDF >= 0 && d.openingFloat.USD >= 0
        && (d.status == 'open' || validClosing(d.closing));
    }

    function validClosing(c) {
      return c is map
        && c.keys().hasOnly(['counted', 'expected', 'variance', 'salesCount', 'revenue', 'notes'])
        && validMoney2(c.counted) && validMoney2(c.expected) && validMoney2(c.variance)
        && c.salesCount is number && c.revenue is number
        && c.notes is string && c.notes.size() <= 500;
    }

    function openingSigned() {
      return request.resource.data.openedBy == request.auth.uid
        && request.resource.data.openedAt == request.time;
    }

    function closingSigned() {
      return request.resource.data.closedBy == request.auth.uid
        && request.resource.data.closedAt == request.time;
    }

    // Fin de l'essai : la date enregistrée, ou 30 jours après la création pour les anciennes boutiques.
    function trialEndOf(b) {
      return b.get('trialEndsAt', b.createdAt + duration.value(30, 'd'));
    }

    // L'abonnement court encore, ou ses 7 jours de grâce. Après : lecture seule.
    function notBlocked(bid) {
      let b = get(/databases/$(database)/documents/boutiques/$(bid)).data;
      let paid = b.get('paidUntil', null);
      let end = (paid != null && paid > trialEndOf(b)) ? paid : trialEndOf(b);
      return request.time < end + duration.value(7, 'd');
    }

    // La vente citée par le mouvement en cours d'écriture, telle qu'elle sera après l'écriture.
    function saleAfter(bid) {
      return getAfter(/databases/$(database)/documents/boutiques/$(bid)/sales/$(request.resource.data.refId)).data;
    }

    function catalogFields() {
      return ['sku', 'name', 'category', 'sellPrice', 'unit', 'alertThreshold', 'barcode', 'packs', 'favorite', 'archived'];
    }

    /** Montants d'un compteur mensuel : FC, $ et € seulement, des nombres (négatifs possibles un instant, pendant une annulation hors ligne). */
    function validMonthMoney(m) {
      return m is map
        && m.keys().hasOnly(['CDF', 'USD', 'EUR'])
        && m.get('CDF', 0) is number && m.get('USD', 0) is number && m.get('EUR', 0) is number;
    }

    function validProduct(p) {
      return p.get('sku', '') is string && p.get('sku', '').size() <= 20
        && p.get('packs', []) is list && p.get('packs', []).size() <= 5
        && p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.category is string && p.category.size() <= 60
        && p.sellPrice is number && p.sellPrice >= 0
        && p.unit in ['u', 'kg', 'L']
        && p.stock is number
        && p.alertThreshold is number && p.alertThreshold >= 0
        && p.barcode is string && p.barcode.size() <= 64
        && p.favorite is bool
        && p.archived is bool;
    }

    // Le mouvement cité par le produit est créé dans cette même écriture et porte la même variation.
    function movementMatches(bid, pid, delta) {
      let mv = getAfter(/databases/$(database)/documents/boutiques/$(bid)/stockMovements/$(request.resource.data.lastMovementId)).data;
      return request.resource.data.lastMovementId is string
        && request.resource.data.lastMovementId != (resource == null ? '' : resource.data.get('lastMovementId', ''))
        && mv.createdAt == request.time
        && pid in mv.deltas
        && math.abs(delta - mv.deltas[pid]) < 0.0005;
    }

    // Droit effectif : le propriétaire a tout ; sinon l'ajustement du propriétaire, ou la valeur du rôle.
    function can(bid, perm) {
      let m = get(/databases/$(database)/documents/boutiques/$(bid)/members/$(request.auth.uid)).data;
      return isActive(bid)
        && (m.role == 'proprietaire'
            || m.get('permissions', {}).get(perm, m.role == 'gerant') == true);
    }
  }
}
